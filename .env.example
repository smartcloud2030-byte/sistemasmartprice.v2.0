# ─────────────────────────────────────────
# SmartPrice — Variáveis de Ambiente (VPS)
# ─────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o GitHub!

VITE_API_SECRET=smartprice-api-2026
API_SECRET=smartprice-api-2026

# Domínio principal (sem https://)
DOMAIN=seudominio.com.br

# Banco de dados PostgreSQL
DB_PASSWORD=SUA_SENHA_FORTE_AQUI

# MinIO (armazenamento de imagens)
MINIO_ACCESS_KEY=smartprice_admin
MINIO_SECRET_KEY=SUA_SENHA_MINIO_FORTE_AQUI

# Supabase (manter enquanto não migrar completamente)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx

# Google AI (se usar no app)
VITE_GOOGLE_AI_KEY=AIzaxxxxxxxxxx

# Asaas (bloqueio por pendência de pagamento) — deixe em branco até ter conta
# no Asaas; sem isso, o recurso simplesmente não é usado (nenhum CNPJ é
# afetado). ASAAS_ENV: sandbox (teste) ou production. ASAAS_WEBHOOK_TOKEN é um
# token que você mesmo inventa e cadastra no painel do Asaas ao configurar o
# webhook (aba Integrações > Webhooks), pra confirmar que a chamada é legítima.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Firebase (se usar no app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NFS-e — API da Prefeitura de Bacabal (Prefeitura Moderna). Token gerado em
# "Token API" no portal, atrelado ao CNPJ do prestador. Sem isso, o botão de
# emitir nota fiscal simplesmente falha com "configuração inválida".
NFSE_API_BASE_URL=https://bacabal-ma.prefeituramoderna.com.br/nfse/api/v1
NFSE_API_TOKEN=
NFSE_PRESTADOR_CNPJ=66125544000198

# Gmail SMTP — envio da nota fiscal por e-mail pro cliente. GMAIL_APP_PASSWORD
# é gerado em myaccount.google.com/apppasswords (não é a senha normal do Gmail).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Node
NODE_ENV=production
